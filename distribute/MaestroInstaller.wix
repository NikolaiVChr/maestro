<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.microsoft.com/wix/2006/wi tools/wix/doc/wix.xsd">
    <?define MaestroAppName=Maestro?>
    <?define MaestroDescription=Maestro MIDI to ABC converter?>
    <?define MaestroDescriptionLong=Maestro is a MIDI to ABC converter for The Lord of the Rings Online. Use it to arrange multi-part ABC files to play in the game with your friends, or create solo pieces to play yourself.?>
    <?define MaestroAppUserModelId=Aifel.Maestro?>
    <?define AbcPlayerAppName=ABC Player?>
    <?define AbcPlayerDescription=ABC Player for the Lord of the Rings Online?>
    <?define AbcPlayerDescriptionLong=Use ABC Player to listen to .abc files as they would sound in The Lord of the Rings Online's player music system.?>
    <?define AbcPlayerAppUserModelId=Aifel.AbcPlayer?>
    <?define AbcToolsAppName=ABC Tools?>
    <?define AbcToolsDescription=ABC tools to merge abc files or auto export abc?>
    <?define AbcToolsAppUserModelId=Aifel.AbcTools?>
    <?define ApplicationFolderName=Maestro?>
    <Product Id="*" UpgradeCode="{6AA5E0BF-7CA7-4D11-9687-28751293C91A}" Name="Maestro and ABC Player" Manufacturer="DigeroAifelElamond" Version="$(var.MaestroVersion)" Language="1033">
        <Package Id="*" Description="!(loc.Package_Description)" Languages="1033" Compressed="yes" SummaryCodepage="1252" InstallScope="perUser" InstallPrivileges="limited"/>
        <Media Id="1" Cabinet="Maestro.cab" EmbedCab="yes" />
        <!-- Expose defines as properties for the MaestroInstallerStrings.wxl -->
        <Property Id="MaestroAppName">$(var.MaestroAppName)</Property>
        <Property Id="MaestroVersion">$(var.MaestroVersion)</Property>
        <Property Id="AbcPlayerAppName">$(var.AbcPlayerAppName)</Property>
        <Property Id="AbcPlayerVersion">$(var.AbcPlayerVersion)</Property>
        <Property Id="AbcToolsAppName">$(var.AbcToolsAppName)</Property>
        <Property Id="AbcToolsVersion">$(var.AbcToolsVersion)</Property>
        <!-- Installer UI -->
        <UI>
            <UIRef Id="WixUI_FeatureTree" />
            <!-- Skip license dialog -->
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="2">NOT Installed</Publish>
            <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3">NOT Installed</Publish>
        </UI>
        <WixVariable Id="WixUIBannerBmp" Value="MaestroInstaller-banner.bmp" />
        <WixVariable Id="WixUIDialogBmp" Value="MaestroInstaller-dialog.bmp" />
        <Property Id="ApplicationFolderName" Value="$(var.ApplicationFolderName)" />
        <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
        <Property Id="WixAppFolder" Value="WixPerUserFolder" />
        <WixVariable Id="WixUISupportPerUser" Value="1" />

        <!-- check for old per machine install of Maestro. If found, display message and quit. Is important so will display in german and french too. -->
        <Upgrade Id="{CCA9F6BF-F1FB-4D8E-8892-3AFE3CE6F4B7}">
            <UpgradeVersion Property="OLD_PER_MACHINE_FOUND"
                            Minimum="0.0.0.0"
                            IncludeMinimum="yes"
                            OnlyDetect="yes" />
        </Upgrade>
        <Condition Message="!(loc.OldVersionError_FR)">
            <![CDATA[NOT OLD_PER_MACHINE_FOUND OR UserLanguageID <> 1036]]>
        </Condition>
        <Condition Message="!(loc.OldVersionError_DE)">
            <![CDATA[NOT OLD_PER_MACHINE_FOUND OR UserLanguageID <> 1031]]>
        </Condition>
        <Condition Message="!(loc.OldVersionError_EN)">
            <![CDATA[NOT OLD_PER_MACHINE_FOUND OR (UserLanguageID = 1036 OR UserLanguageID = 1031)]]>
        </Condition>
        <!-- Uninstall old versions of Maestro -->
        <Upgrade Id="{6AA5E0BF-7CA7-4D11-9687-28751293C91A}">
            <UpgradeVersion Property="NEWERFOUND" OnlyDetect="no" Minimum="$(var.MaestroVersion)" IncludeMinimum="no" />
            <UpgradeVersion Property="SELFFOUND" OnlyDetect="no" Minimum="$(var.MaestroVersion)" IncludeMinimum="yes" Maximum="$(var.MaestroVersion)" IncludeMaximum="yes" />
            <UpgradeVersion Property="PREVIOUSFOUND" OnlyDetect="no" Maximum="$(var.MaestroVersion)" IncludeMaximum="no" />
        </Upgrade>
        <!-- Warn user if a newer version is installed. -->
        <!--CustomAction Id="NoDowngrade" Error="A newer version of [ProductName] is already installed." /-->
        <!-- <CustomAction Id="AlreadyInstalled" Error="[ProductName] v$(var.MaestroVersion) is already installed." /> -->
        <InstallExecuteSequence>
            <!--Custom Action="NoDowngrade" After="FindRelatedProducts">NEWERFOUND</Custom-->
            <!-- <Custom Action="AlreadyInstalled" After="FindRelatedProducts">SELFFOUND</Custom> -->
            <RemoveExistingProducts Before="InstallInitialize" />
        </InstallExecuteSequence>
        <!-- Icons -->
        <Icon Id="maestro.ico" SourceFile="maestro.ico" />
        <Icon Id="abcplayer.ico" SourceFile="abcplayer.ico" />
        <Icon Id="abctools.ico" SourceFile="abctools.ico" />
        <Property Id="ARPPRODUCTICON" Value="maestro.ico" />
        <!-- find where last Maestro was installed -->
        <Property Id="APPLICATIONFOLDER">
            <RegistrySearch Id="FindInstallLocation"
                            Root="HKCU"
                            Key="Software\[Manufacturer]\Maestro"
                            Name="InstallLocation"
                            Type="raw" />
        </Property>
        <!-- Add/Remove Programs icon -->
        <!-- File System -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <!-- Program Files -->
            <Directory Id="LocalAppDataFolder">
                <Directory Id="APPLICATIONFOLDER" Name="$(var.ApplicationFolderName)">
                    <Component Id="ApplicationFolderCleanup" Guid="{6999F0FB-F82B-41C1-9009-A33BB6EEEC6E}">
                        <!--RegistryValue Root="HKCU" Key="Software\[Manufacturer]\Maestro\Install" Name="RootCleanup" Type="string" Value="1" KeyPath="yes" /-->
                        <RegistryValue Root="HKCU"
                                           Key="Software\[Manufacturer]\Maestro"
                                           Name="InstallLocation"
                                           Type="string"
                                           Value="[APPLICATIONFOLDER]"
                                           KeyPath="yes" />

                        <RegistryValue Root="HKCU"
                                       Key="Software\[Manufacturer]\Maestro"
                                       Name="RootCleanup"
                                       Type="string"
                                       Value="1" />
                        <RemoveFolder Id="Remove_APPLICATIONFOLDER" On="uninstall" />
                    </Component>
                    <Directory Id="AppDir" Name="app">
                        <Component Id="Assets" Guid="{FA9EB453-5DE0-40FA-AD8E-37A98D97FA4E}">
                            <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\Maestro\Install" Name="AssetsReg" Type="string" Value="1" KeyPath="yes" />
                            <RemoveFolder Id="Remove_AppDir" On="uninstall" />
                            <!--File Source="LotroInstruments.sf2" /-->
                            <File Id="file.maestro.ico" Source="maestro.ico" />
                            <File Id="file.midifile.ico" Source="midifile.ico" />
                            <File Id="file.msxfile.ico" Source="msxfile.ico" />
                            <File Id="file.abcplayer.ico" Source="abcplayer.ico" />
                            <File Id="file.abcfile.ico" Source="abcfile.ico" />
                            <File Id="file.abcplaylist.ico" Source="abcplaylist.ico" />
                            <File Id="file.abctools.ico" Source="abctools.ico" />
                        </Component>
                        <Component Id="MaestroJar" Guid="{D3680C55-4169-40B8-BE50-66BF3157563A}">
                            <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\Maestro\Install" Name="MaestroJarReg" Type="string" Value="1" KeyPath="yes" />

                            <RemoveFolder Id="Remove_AppDir_MaestroJar" Directory="AppDir" On="uninstall" />

                            <File Source="$(var.build)/app/Maestro.jar" />
                            <File Source="$(var.build)/app/Maestro.cfg" />
                        </Component>
                        <Component Id="AbcPlayerJar" Guid="{F04A2784-CA2F-4045-8AF4-30CF4B915E11}">
                            <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\Maestro\Install" Name="AbcPlayerJarReg" Type="string" Value="1" KeyPath="yes" />

                            <RemoveFolder Id="Remove_AppDir_PlayerJar" Directory="AppDir" On="uninstall" />

                            <File Source="$(var.build)/app/AbcPlayer.jar" />
                            <File Source="$(var.build)/app/AbcPlayer.cfg" />
                        </Component>
                        <Component Id="AbcToolsJar" Guid="{3205ECE3-FF2F-42F4-8BB8-E771C44AE948}">
                            <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\Maestro\Install" Name="AbcToolsJarReg" Type="string" Value="1" KeyPath="yes" />

                            <RemoveFolder Id="Remove_AppDir_ToolsJar" Directory="AppDir" On="uninstall" />

                            <File Source="$(var.build)/app/AbcTools.jar" />
                            <File Source="$(var.build)/app/AbcTools.cfg" />
                        </Component>
                        <Component Id="PatchJar" Guid="{871DB040-38B5-4DF2-A98D-36E97CDBC6EE}">
                            <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\Maestro\Install" Name="PatchJarReg" Type="string" Value="1" KeyPath="yes" />

                            <RemoveFolder Id="Remove_AppDir_PatchJar" Directory="AppDir" On="uninstall" />

                            <File Source="$(var.build)/app/java.midi.patch.jar" />
                        </Component>
                    </Directory>
                    <Directory Id="RuntimeDir" Name="runtime" >
                    </Directory>
                    <Component Id="aifel_changelog.txt" Guid="{EB2AA314-6451-4626-893B-7688AD63291A}">
                        <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\Maestro\Install" Name="aifel_changelog_txtReg" Type="string" Value="1" KeyPath="yes" />
                        <File Id="aifel_changelog.txt" Source="readme.txt" />
                    </Component>
                    <Component Id="MaestroExecutable" Guid="{1F6DBC83-47FC-4972-9232-A98BA49678FF}">
                        <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\Maestro\Install" Name="MaestroExecutableReg" Type="string" Value="1" KeyPath="yes" />
                        <CreateFolder Directory="MaestroStartMenuFolder" />
                        <File Id="Maestro.exe" Source="$(var.build)/Maestro.exe" >
                            <Shortcut Id="Maestro.lnk" Name="$(var.MaestroAppName)" Description="$(var.MaestroDescription)" WorkingDirectory="APPLICATIONFOLDER" Directory="MaestroStartMenuFolder" Icon="maestro.ico" IconIndex="0" Advertise="no">
                                <!-- App user model ID guid (https://learn.microsoft.com/en-us/windows/win32/properties/props-system-appusermodel-id) -->
                                <!-- Allows for taskbar pinning -->
                                <ShortcutProperty Key="{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}, 5" Value="$(var.MaestroAppUserModelId)" />
                            </Shortcut>
                        </File>
                        <!-- Define ProgIds for file types -->
                        <ProgId Id="Maestro.AssocFile.ABC" Description="ABC Song">
                            <Extension Id="abc" ContentType="text/plain">
                                <Verb Id="edit" Command="&amp;Edit" TargetFile="Maestro.exe" Argument="&quot;%1&quot;" />
                            </Extension>
                        </ProgId>
                        <ProgId Id="Maestro.AssocFile.MIDI" Description="MIDI Sequence">
                            <Extension Id="mid" ContentType="audio/mid">
                                <Verb Id="edit" Command="&amp;Edit" TargetFile="Maestro.exe" Argument="&quot;%1&quot;" />
                            </Extension>
                            <Extension Id="midi" ContentType="audio/mid" />
                            <Extension Id="kar" ContentType="audio/mid" />
                        </ProgId>
                        <ProgId Id="Maestro.AssocFile.MSX" Description="Maestro Song">
                            <Extension Id="msx" ContentType="application/vnd.digero-maestro+xml">
                                <Verb Id="edit" Command="&amp;Edit with $(var.MaestroAppName)" TargetFile="Maestro.exe" Argument="&quot;%1&quot;" />
                            </Extension>
                        </ProgId>
                        <!-- file associations icons -->
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Maestro.AssocFile.MIDI\DefaultIcon" Value="[#file.midifile.ico],0" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Maestro.AssocFile.MSX\DefaultIcon" Value="[#file.msxfile.ico],0" Type="string" />
                        <!--RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Maestro.AssocFile.ABC\DefaultIcon" Value="[#file.maestro.ico],0" Type="string" /-->
                        <!-- Support Set Program Access and Defaults -->
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities" Type="string" Name="ApplicationName" Value="$(var.MaestroAppName)" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities" Type="string" Name="ApplicationDescription" Value="$(var.MaestroDescriptionLong)" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities" Type="string" Name="ApplicationIcon" Value="[APPLICATIONFOLDER]app\maestro.ico,0" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\DefaultIcon" Type="string" Value="[APPLICATIONFOLDER]app\maestro.ico,0" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\FileAssociations" Type="string" Name=".abc" Value="Maestro.AssocFile.ABC" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\FileAssociations" Type="string" Name=".mid" Value="Maestro.AssocFile.MIDI" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\FileAssociations" Type="string" Name=".kar" Value="Maestro.AssocFile.MIDI" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\FileAssociations" Type="string" Name=".midi" Value="Maestro.AssocFile.MIDI" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\FileAssociations" Type="string" Name=".msx" Value="Maestro.AssocFile.MSX" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\MIMEAssociations" Type="string" Name="text/plain" Value="Maestro.AssocFile.ABC" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\MIMEAssociations" Type="string" Name="audio/mid" Value="Maestro.AssocFile.MIDI" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\MIMEAssociations" Type="string" Name="audio/midi" Value="Maestro.AssocFile.MIDI" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\MIMEAssociations" Type="string" Name="midi/mid" Value="Maestro.AssocFile.MIDI" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\MIMEAssociations" Type="string" Name="application/vnd.digero-maestro+xml" Value="Maestro.AssocFile.MSX" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\shell\edit" Type="string" Value="&amp;Edit with $(var.MaestroAppName)" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro\Capabilities\shell\edit\command" Type="string" Value="&quot;[#Maestro.exe]&quot; &quot;%1&quot;" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\RegisteredApplications" Type="string" Name="Digero.Maestro.exe" Value="SOFTWARE\[Manufacturer]\Maestro\Capabilities" />
                        <!-- Support Start/Run "Start Maestro.bat" -->
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\Maestro.exe" Type="string" Value="[#Maestro.exe]" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\Maestro.exe" Type="string" Name="Path" Value="[APPLICATIONFOLDER]" />
                        <!-- Add to "Open With" menu -->
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\Maestro.exe" Type="string" Name="FriendlyAppName" Value="$(var.MaestroAppName)" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\Maestro.exe\SupportedTypes" Type="string" Name=".abc" Value="" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\Maestro.exe\SupportedTypes" Type="string" Name=".mid" Value="" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\Maestro.exe\SupportedTypes" Type="string" Name=".kar" Value="" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\Maestro.exe\SupportedTypes" Type="string" Name=".midi" Value="" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\Maestro.exe\SupportedTypes" Type="string" Name=".msx" Value="" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\Maestro.exe\shell\edit" Type="string" Value="&amp;Edit with $(var.MaestroAppName)" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\Maestro.exe\shell\edit\command" Type="string" Value="&quot;[#Maestro.exe]&quot; &quot;%1&quot;" />
                        <!-- Add entry to right-click context menu regardless of if Maestro is the default editor -->
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.abc\Shell\Maestro.Edit" Value="&amp;Edit with Maestro" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.abc\Shell\Maestro.Edit" Name="Icon" Value="[APPLICATIONFOLDER]app\maestro.ico,0" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.abc\Shell\Maestro.Edit\command" Value="&quot;[#Maestro.exe]&quot; &quot;%1&quot;" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.mid\Shell\Maestro.Edit" Value="&amp;Edit with Maestro" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.mid\Shell\Maestro.Edit" Name="Icon" Value="[APPLICATIONFOLDER]app\maestro.ico,0" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.mid\Shell\Maestro.Edit\command" Value="&quot;[#Maestro.exe]&quot; &quot;%1&quot;" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.kar\Shell\Maestro.Edit" Value="&amp;Edit with Maestro" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.kar\Shell\Maestro.Edit" Name="Icon" Value="[APPLICATIONFOLDER]app\maestro.ico,0" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.kar\Shell\Maestro.Edit\command" Value="&quot;[#Maestro.exe]&quot; &quot;%1&quot;" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.midi\Shell\Maestro.Edit" Value="&amp;Edit with Maestro" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.midi\Shell\Maestro.Edit" Name="Icon" Value="[APPLICATIONFOLDER]app\maestro.ico,0" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\SystemFileAssociations\.midi\Shell\Maestro.Edit\command" Value="&quot;[#Maestro.exe]&quot; &quot;%1&quot;" Type="string" />
                    </Component>
                    <Component Id="AbcPlayerExecutable" Guid="{07AC436E-234B-4EE1-A685-E5BDC8822362}">
                        <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\Maestro\Install" Name="AbcPlayerExecutableReg" Type="string" Value="1" KeyPath="yes" />
                        <CreateFolder Directory="MaestroStartMenuFolder" />
                        <File Id="AbcPlayer.exe" Source="$(var.build)/AbcPlayer.exe" >
                            <Shortcut Id="AbcPlayer64.lnk" Name="$(var.AbcPlayerAppName)" Description="$(var.AbcPlayerDescription)" WorkingDirectory="APPLICATIONFOLDER" Directory="MaestroStartMenuFolder" Icon="abcplayer.ico" IconIndex="0" Advertise="no">
                                <!-- App user model ID guid (https://learn.microsoft.com/en-us/windows/win32/properties/props-system-appusermodel-id) -->
                                <ShortcutProperty Key="{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}, 5" Value="$(var.AbcPlayerAppUserModelId)" />
                            </Shortcut>
                        </File>
                        <!-- Define ProgID for ABC file type -->
                        <ProgId Id="AbcPlayer.AssocFile.ABC" Description="ABC Song">
                            <Extension Id="abc" ContentType="text/plain">
                                <Verb Id="play" TargetFile="AbcPlayer.exe" Argument="&quot;%1&quot;" />
                            </Extension>
                        </ProgId>
                        <!-- Define ProgID for ABCP file type -->
                        <ProgId Id="AbcPlayer.AssocFile.ABCP" Description="ABC Playlist">
                            <Extension Id="abcp" ContentType="text/plain">
                                <Verb Id="play" TargetFile="AbcPlayer.exe" Argument="&quot;%1&quot;" />
                            </Extension>
                        </ProgId>
                        <!-- file associations icons -->
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\AbcPlayer.AssocFile.ABC\DefaultIcon" Value="[#file.abcfile.ico],0" Type="string" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\AbcPlayer.AssocFile.ABCP\DefaultIcon" Value="[#file.abcplaylist.ico],0" Type="string" />
                        <!-- Support Set Program Access and Defaults -->
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\AbcPlayer\Capabilities" Type="string" Name="ApplicationName" Value="$(var.AbcPlayerAppName)" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\AbcPlayer\Capabilities" Type="string" Name="ApplicationDescription" Value="$(var.AbcPlayerDescriptionLong)" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\AbcPlayer\Capabilities" Type="string" Name="ApplicationIcon" Value="[APPLICATIONFOLDER]app\abcplayer.ico,0" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\AbcPlayer\Capabilities\DefaultIcon" Type="string" Value="[#file.abcfile.ico],0" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\AbcPlayer\Capabilities\FileAssociations" Type="string" Name=".abc" Value="AbcPlayer.AssocFile.ABC" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\AbcPlayer\Capabilities\FileAssociations" Type="string" Name=".abcp" Value="AbcPlayer.AssocFile.ABCP" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\AbcPlayer\Capabilities\MIMEAssociations" Type="string" Name="text/plain" Value="AbcPlayer.AssocFile.ABC" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\AbcPlayer\Capabilities\shell" Type="string" Value="open" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\AbcPlayer\Capabilities\shell\open\command" Type="string" Value="&quot;[#AbcPlayer.exe]&quot; &quot;%1&quot;" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\RegisteredApplications" Type="string" Name="Digero.AbcPlayer64.exe" Value="SOFTWARE\[Manufacturer]\AbcPlayer\Capabilities" />
                        <!-- Support Start/Run "AbcPlayer.exe" -->
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\AbcPlayer64.exe" Type="string" Value="[#AbcPlayer.exe]" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\AbcPlayer64.exe" Type="string" Name="Path" Value="[APPLICATIONFOLDER]" />
                        <!-- Add to "Open With" menu -->
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\AbcPlayer.exe" Type="string" Name="FriendlyAppName" Value="$(var.AbcPlayerAppName)" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\AbcPlayer.exe\SupportedTypes" Type="string" Name=".abc" Value="" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\AbcPlayer.exe\SupportedTypes" Type="string" Name=".abcp" Value="" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\AbcPlayer.exe\shell" Type="string" Value="open" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Applications\AbcPlayer.exe\shell\open\command" Type="string" Value="&quot;[#AbcPlayer.exe]&quot; &quot;%1&quot;" />
                    </Component>
                    <Component Id="AbcToolsExecutable" Guid="{A12B5DDE-AD4A-4B69-A5B8-3641F7854DDB}">
                        <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\Maestro\Install" Name="AbcToolsExecutableReg" Type="string" Value="1" KeyPath="yes" />
                        <CreateFolder Directory="MaestroStartMenuFolder" />
                        <File Id="AbcTools.exe" Source="$(var.build)/AbcTools.exe" >
                            <Shortcut Id="AbcTools.lnk" Name="$(var.AbcToolsAppName)" Description="$(var.AbcToolsDescription)" WorkingDirectory="APPLICATIONFOLDER" Directory="MaestroStartMenuFolder" Icon="abctools.ico" IconIndex="0" Advertise="no">
                                <!-- App user model ID guid (https://learn.microsoft.com/en-us/windows/win32/properties/props-system-appusermodel-id) -->
                                <ShortcutProperty Key="{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}, 5" Value="$(var.AbcToolsAppUserModelId)" />
                            </Shortcut>
                        </File>
                    </Component>
                </Directory>
            </Directory>
            <!-- Start Menu -->
            <Directory Id="ProgramMenuFolder">
                <Directory Id="MaestroStartMenuFolder" Name="$(var.MaestroAppName)">
                    <Component Id="MaestroStartMenuFolder" Guid="{DA4DB77A-F32C-49A3-B15A-3BCB6D3AC8B7}">
                        <RemoveFolder Id="MaestroStartMenuFolder" On="uninstall" />
                        <RegistryValue Root="HKCU" Key="SOFTWARE\[Manufacturer]\Maestro" Type="integer" Name="StartMenuShortcuts" Value="1" KeyPath="yes" />
                    </Component>
                </Directory>
            </Directory>
        </Directory>
        <!-- Features -->
        <Feature Id="Common" Level="1" ConfigurableDirectory="APPLICATIONFOLDER" Absent="disallow" AllowAdvertise="no" Title="Common files" Description="Files required by both $(var.MaestroAppName) and $(var.AbcPlayerAppName).">
            <ComponentRef Id="Assets" />
            <ComponentRef Id="aifel_changelog.txt" />
            <ComponentRef Id="PatchJar" />
            <ComponentGroupRef Id="j24RuntimeComponentGroup" />
            <ComponentRef Id="ApplicationFolderCleanup" />
        </Feature>
        <Feature Id="Maestro" Level="1" ConfigurableDirectory="APPLICATIONFOLDER" AllowAdvertise="no" Title="$(var.MaestroAppName)" Description="$(var.MaestroAppName) is a MIDI to ABC converter. Arrange multipart ABC files from MIDI source files.">
            <ComponentRef Id="Assets" />
            <ComponentRef Id="MaestroStartMenuFolder" />
            <ComponentRef Id="MaestroExecutable" />
            <ComponentRef Id="MaestroJar" />
        </Feature>
        <Feature Id="AbcPlayer" Level="1" ConfigurableDirectory="APPLICATIONFOLDER" AllowAdvertise="no" Title="$(var.AbcPlayerAppName)" Description="$(var.AbcPlayerAppName) lets you preview ABC files as they would sound in The Lord of the Rings Online.">
            <ComponentRef Id="Assets" />
            <ComponentRef Id="MaestroStartMenuFolder" />
            <ComponentRef Id="AbcPlayerExecutable" />
            <ComponentRef Id="AbcPlayerJar" />
        </Feature>
        <Feature Id="AbcTools" Level="1" ConfigurableDirectory="APPLICATIONFOLDER" AllowAdvertise="no" Title="$(var.AbcToolsAppName)" Description="$(var.AbcToolsAppName) lets you merge old single-part abc files into multi-part abc songs. Or auto export abc.">
            <ComponentRef Id="Assets" />
            <ComponentRef Id="MaestroStartMenuFolder" />
            <ComponentRef Id="AbcToolsExecutable" />
            <ComponentRef Id="AbcToolsJar" />
        </Feature>
    </Product>
</Wix>